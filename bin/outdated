#!/bin/sh
#
# NOTE:
# Report what has updates available.
#
# Applies nothing.
#
# It does use the network, because "is anything newer?" cannot be answered locally.
#
# Ordered the way things are installed: Homebrew first, since it provides the managers below it, then each manager's
# own layer.
#
# This exists because the answer is spread across six tools, not because updating needs a wrapper.
#
# The commands that apply updates are in docs/maintenance.md.

set -u

section() {
    printf '\n%s\n' "$*"
}

section "Homebrew"

if command -v brew >/dev/null 2>&1; then
    brew update >/dev/null 2>&1 || true

    outdated="$(brew outdated 2>/dev/null)"

    if [ -n "$outdated" ]; then
        printf '%s\n' "$outdated" | sed 's/^/  /'

        printf '  -> brew upgrade\n'
    else
        printf '  up to date\n'
    fi
else
    printf '  not installed\n'
fi

section "Alacritty"

# NOTE:
# Installed by hand, so brew outdated cannot see it, and the project's latest GitHub release is asked instead.
#
# plutil reads JSON as well as property lists, so the answer needs nothing Homebrew installs.
if [ -d /Applications/Alacritty.app ]; then
    installed="$(
        defaults read /Applications/Alacritty.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null
    )"

    latest="$(
        curl -fsSL https://api.github.com/repos/alacritty/alacritty/releases/latest 2>/dev/null |
            plutil -extract tag_name raw -o - - 2>/dev/null
    )"

    if [ -z "$latest" ]; then
        printf '  %s installed; could not ask GitHub for the latest release\n' "$installed"
    elif [ "v$installed" = "$latest" ]; then
        printf '  up to date\n'
    else
        printf '  %s installed, %s released\n' "$installed" "$latest"

        printf '  -> the new .dmg, installed as in the README, then ./scripts/40-derived-state.sh\n'
    fi
else
    printf '  not installed\n'
fi

section "zsh plugins"

printf '  zinit has no read-only check; updating is the only way to see changes\n'

printf '  -> zinit update --all\n'

section "tmux plugins"

printf '  tpm has no read-only check\n'

printf '  -> prefix + U inside tmux\n'

section "Neovim plugins"

printf '  Lazy owns the lockfile, so this is checked from inside Neovim\n'

printf '  -> :Lazy check, then :Lazy update and review the lazy-lock.json diff\n'

section "Neovim tooling"

printf '  -> :Mason, then U\n'

section "uv tools"

if command -v uv >/dev/null 2>&1; then
    outdated="$(uv tool list --outdated 2>/dev/null | grep -v '^-' || true)"

    if [ -n "$outdated" ]; then
        printf '%s\n' "$outdated" | sed 's/^/  /'

        printf '  -> uv tool upgrade --all\n'
    else
        printf '  up to date\n'
    fi
else
    printf '  not installed\n'
fi

section "Rust"

if command -v rustup >/dev/null 2>&1; then
    rustup check 2>/dev/null | sed 's/^/  /'

    printf '  -> rustup update\n'
else
    printf '  not installed\n'
fi

printf '\nNothing above was changed.\n'
