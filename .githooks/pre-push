#!/bin/sh
#
# NOTE:
# Refuse a push that would leave lazy-lock.json out of step with the plugins this machine runs.
#
# This hook is provided by the repository but is not active by default, because Git never enables a hook from a clone
# on its own; docs/maintenance.md says how to opt in.
#
# It catches two ways that happens: a plugin update whose lockfile change is not committed, so the push leaves it
# behind, and plugins installed at commits the pushed lockfile does not record, which is what discarding the lockfile
# change without :Lazy restore leaves.
#
# It never changes a file and never touches the network: it compares what Git records with the commit each installed
# plugin is on, and it starts Neovim only with --clean, so no plugin loads.
#
# A push from a machine with no Neovim plugins installed skips the comparison, because there is nothing to compare.
#
# To try an update for a while before committing it, as docs/maintenance.md describes, push with
# `git push --no-verify` until then.

set -u

lockfile="nvim/.config/nvim/lazy-lock.json"

if ! git diff --quiet HEAD -- "$lockfile"; then
    printf 'pre-push: %s has changes that are not committed, so this push would leave them behind\n' "$lockfile" >&2

    printf 'pre-push: commit them, or run :Lazy restore and discard them, or push with --no-verify\n' >&2

    exit 1
fi

plugins="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy"

if [ ! -d "$plugins" ]; then
    exit 0
fi

if ! command -v nvim >/dev/null 2>&1; then
    printf 'pre-push: nvim is needed to compare the installed plugins with %s\n' "$lockfile" >&2

    exit 1
fi

checks="$(git rev-parse --show-toplevel)/scripts/nvim-checks.lua"

scratch="$(mktemp -d)"

trap 'rm -rf "$scratch"' EXIT

failed=0

# NOTE:
# Git names every ref being pushed on standard input; a commit of zeros means a deletion, which pushes no lockfile.
while read -r _ commit _ _; do
    case "$commit" in
    *[!0]*) ;;
    *) continue ;;
    esac

    if ! git cat-file -e "$commit:$lockfile" 2>/dev/null; then
        continue
    fi

    git show "$commit:$lockfile" >"$scratch/lazy-lock.json"

    name="$lockfile at $(git rev-parse --short "$commit")"

    nvim --clean --headless -l "$checks" installed "$scratch/lazy-lock.json" "$name" "$plugins" || failed=1
done

if [ "$failed" -ne 0 ]; then
    printf 'pre-push: run :Lazy restore so the installed plugins match the lockfile, or push with --no-verify\n' >&2

    exit 1
fi
