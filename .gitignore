# NOTE:
# macOS.
.DS_Store


# NOTE:
# Private software list.
# 
# Never commit this.
# 
# Brewfile.optional.example is the tracked template; the real file is yours.
Brewfile.optional


# NOTE:
# Local Git identity.
# 
# Never commit this.
git/.config/git/config.local


# NOTE:
# Machine-generated state.
#
# With `stow --no-folding` these directories are created outside the repository, so in normal use nothing below should 
# ever appear here.
# 
# The rules stay as a safety net for a folded deployment, or for a stray run of a tool inside the repository.
tmux/.config/tmux/plugins/

zsh/.config/zsh/.zcompcache/

zsh/.config/zsh/.zsh_sessions/

zsh/.config/zsh/.zcompdump*

# NOTE:
# This one is worth more than tidiness: lazygit's state file records the path of every repository you have opened in
# it, which is exactly the kind of thing Brewfile.optional exists to keep out of a public repository.
lazygit/.config/lazygit/state.yml


# NOTE:
# Local taskwarrior configuration.
#
# Never commit this.
#
# Project and client names belong here rather than in the tracked taskrc.
task/.config/task/taskrc.local


# NOTE:
# htop's search and filter history.
#
# This one is not covered by the note above: htop resolves the symbolic link to htoprc and writes its history beside
# the real file, so it lands here in normal use rather than only after a mistake.
htop/.config/htop/htop_history


# NOTE:
# Midnight Commander's history and editor state.
#
# ~/.local/share/mc is a stow target directory, so with --no-folding these stay outside the repository; the rules are
# the safety net.
#
# The history file is the one that matters: it records typed commands, search strings and visited directories.
mc/.local/share/mc/history

mc/.local/share/mc/mcedit/


# NOTE:
# Neovim runtime state.
# 
# lazy-lock.json is deliberately NOT ignored: it is the only place where exact plugin versions are recorded.
nvim/.config/nvim/spell/

nvim/.config/nvim/.luarc.json

nvim/.config/nvim/doc/tags


# NOTE:
# Linter cache.
.rumdl_cache/

